# Encryption key for the session cookie (min. 32 characters). Generate: openssl rand -base64 48
SESSION_PASSWORD=
# Password for /admin (shared with the jury in the submission, never shown on the site)
ADMIN_PASSWORD=
# SQLite file — on Railway mount a volume at /data
DATABASE_PATH=/data/app.db
# Optional: shown in /api/health (Railway sets RAILWAY_GIT_COMMIT_SHA automatically)
APP_COMMIT=
