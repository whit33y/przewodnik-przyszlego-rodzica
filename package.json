{
  "name": "przewodnik-przyszlego-rodzica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "tokens:check": "node scripts/check-contrast.mjs",
    "fixtures:validate": "tsx scripts/validate-fixtures.ts",
    "test": "vitest run tests/unit",
    "test:golden": "vitest run tests/golden --passWithNoTests",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "verify": "npm run typecheck && npm run lint && npm run tokens:check && npm run fixtures:validate && npm run test && npm run test:golden",
    "verify:full": "npm run verify && npm run build && npm run test:e2e",
    "start:standalone": "node scripts/start-standalone.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.1.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22"
  }
}
